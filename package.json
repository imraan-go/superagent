{
  "name": "tj-lhos-panel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/server/db/migrate.ts",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "owner:set-password": "node --env-file-if-exists=.env.local --import tsx scripts/set-owner-password.ts",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:smoke": "LHOS_LIVE=1 node --env-file-if-exists=.env.local ./node_modules/.bin/vitest run"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.2",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "motion": "14.2.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.5",
    "shiki": "4.5.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  }
}
