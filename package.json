{
  "name": "superagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "setup:secret": "tsx scripts/set-secret.ts",
    "setup:doctor": "tsx scripts/doctor.ts",
    "infra:up": "docker compose -f infra/local/compose.yaml --env-file .env up -d --wait",
    "infra:stop": "docker compose -f infra/local/compose.yaml --env-file .env stop",
    "infra:status": "docker compose -f infra/local/compose.yaml --env-file .env ps",
    "infra:reset": "bash scripts/reset-local.sh",
    "temporal:dev": "bash scripts/temporal-dev.sh",
    "db:generate": "pnpm --filter @superagent/db generate",
    "db:migrate": "pnpm --filter @superagent/db migrate",
    "db:seed:dev": "pnpm --filter @superagent/api seed:dev",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @superagent/api dev\" \"pnpm --filter @superagent/web dev\"",
    "worker:dev": "pnpm --filter @superagent/worker dev",
    "start:all": "bash scripts/start-local.sh",
    "stop:all": "bash scripts/stop-local.sh",
    "e2b:template:build": "tsx infra/e2b/build.ts",
    "composio:discover": "tsx scripts/composio-discover.ts",
    "models:verify": "tsx scripts/models-verify.ts",
    "build": "pnpm -r --if-present build",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @superagent/web test:e2e",
    "smoke:cloud": "tsx scripts/smoke-cloud.ts",
    "cleanup:cloud": "tsx scripts/cleanup-cloud.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "10.0.1",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "@superagent/config": "workspace:*",
    "@superagent/agent": "workspace:*",
    "@superagent/connectors": "workspace:*",
    "@superagent/policy": "workspace:*",
    "@superagent/storage": "workspace:*",
    "@superagent/temporal": "workspace:*",
    "@superagent/db": "workspace:*",
    "@superagent/contracts": "workspace:*",
    "@superagent/execution": "workspace:*",
    "@superagent/observability": "workspace:*",
    "pg": "8.23.1",
    "e2b": "2.56.0",
    "drizzle-orm": "0.45.4",
    "@types/pg": "8.23.1"
  }
}
