# Copy is created by `pnpm setup:env`, which also generates local secrets without printing them.
# Real values go only in the gitignored .env (or your deployment secret manager). Never commit .env.
# Variables already exported in your shell take precedence over .env.

APP_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
API_PORT=3001
# Loopback locally; 0.0.0.0 only inside a container on a private network behind the web/ALB.
API_HOST=127.0.0.1
ALLOW_SIGNUP=true

# --- Local infrastructure (generated by setup:env) ---
POSTGRES_PASSWORD=
DATABASE_URL=
BETTER_AUTH_SECRET=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=superagent-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Development-only seed user (rejected when APP_ENV=production)
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# --- Vercel AI Gateway (all model calls go through it) ---
AI_GATEWAY_API_KEY=
AI_MODEL_PRIMARY=anthropic/claude-haiku-5.5
AI_MODEL_BROWSER=anthropic/claude-haiku-5.5
AI_MODEL_ALLOWLIST=anthropic/claude-haiku-5.5
# Optional comma-separated provider restriction, e.g. anthropic
AI_GATEWAY_PROVIDER_ONLY=
# Reporting tags/user attribution add a per-request Gateway surcharge; off by default.
AI_GATEWAY_REPORTING_TAGS=false
AI_MAX_OUTPUT_TOKENS=1500

# --- Composio (per-user connections; sessions API) ---
COMPOSIO_API_KEY=
# Optional custom auth configs (ac_...). Without them Composio-managed auth is used where available.
COMPOSIO_AUTH_CONFIG_GITHUB=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_NOTION=

# --- E2B (code workspaces + Google Chrome browser template) ---
E2B_API_KEY=
E2B_CODE_TEMPLATE_ID=base
# Filled after `pnpm e2b:template:build`
E2B_BROWSER_TEMPLATE_ID=
E2B_CODE_INTERNET_ACCESS=false
# Optional operator-entered E2B rate (USD per sandbox-second) + source; unset => E2B cost shown as unknown
E2B_RATE_USD_PER_SECOND=
E2B_RATE_SOURCE=

# --- Temporal (local dev server by default; Temporal Cloud is opt-in) ---
TEMPORAL_MODE=local
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=personal-agent
# Cloud only (set TEMPORAL_MODE=cloud): API key OR mTLS cert/key paths (not both)
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# --- Budgets (USD). Live execution refuses to run without per-run and monthly limits. ---
LIVE_SMOKE_MAX_COST=1
MAX_COST_PER_RUN=0.25
MONTHLY_COST_LIMIT=10
COST_CURRENCY=USD

# --- Run limits and retention ---
MAX_MODEL_DECISIONS_PER_RUN=20
MAX_TOOL_CALLS_PER_RUN=30
MAX_ACTIVE_EXECUTION_MINUTES=15
E2B_IDLE_PAUSE_MINUTES=5
APPROVAL_EXPIRY_HOURS=24
TASK_RETENTION_DAYS=30
OPERATIONAL_LOG_RETENTION_DAYS=7
MAX_ARTIFACT_BYTES=26214400
