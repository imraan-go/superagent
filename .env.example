# ── tj-lhos-panel environment ─────────────────────────────────────────────
# Copy → .env.local  (or run: bash scripts/sync-env.sh to fill LHOS values)
# NEVER commit .env.local. Nothing here may be exposed with NEXT_PUBLIC_.

# App
APP_URL=https://panel.hostx.h22t.com
PORT=3100
# 32-byte base64 (session + AES-GCM). sync-env.sh generates it if empty.
PANEL_SECRET_KEY=
# The only account allowed to log in. The argon2id hash lives in the `users`
# table, not here — set it with:  npm run owner:set-password -- you@example.com
# (reads the password from a hidden prompt, never from argv or chat).
OWNER_EMAIL=

# Database
# Host-facing URL (local dev, migrations, pg_dump). Port 5433 because 5432 is
# already taken by E2B's local-dev-postgres-1 — see IMPLEMENTATION_PLAN ADR-03.
# docker-compose overrides this to postgres://panel:…@db:5432/panel in-container.
DATABASE_URL=postgres://panel:panel@127.0.0.1:5433/panel
POSTGRES_PASSWORD=panel

# LHOS agent server (filled by scripts/sync-env.sh from /root/e2b-agent-vm/secrets/)
LHOS_BASE_URL=https://mcp.hostx.h22t.com
LHOS_MCP_TOKEN=
# Server-side approvals proxy ONLY — never reaches client JS or any model
LHOS_APPROVE_TOKEN=
LHOS_VNC_URL=https://vnc.hostx.h22t.com/

# E2B core API (Manage mode) — key filled by sync-env.sh
E2B_API_URL=http://hostx.h22t.com:3000
E2B_API_KEY=

# Manage-mode host bridge — allowlisted host control daemon on loopback
# (e2b-agent-vm/bin/host_bridge.py). Token filled by sync-env.sh.
BRIDGE_URL=http://127.0.0.1:7071
BRIDGE_TOKEN=

# Model vendors (or enter in Settings UI — stored encrypted in DB)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Connectors
COMPOSIO_API_KEY=
PIPEDREAM_API_KEY=

# Uploads directory (outside the web root). Default: /var/lib/tj-lhos-panel/uploads in production, ./uploads in dev.
# UPLOAD_DIR=
